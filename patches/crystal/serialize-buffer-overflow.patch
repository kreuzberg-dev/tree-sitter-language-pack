+        if (offset + 3 + heredoc->identifier.size >
+            TREE_SITTER_SERIALIZATION_BUFFER_SIZE) {
+            break;
+        }
+
         buffer[offset++] = (char)heredoc->allow_escapes;
         buffer[offset++] = (char)heredoc->started;
 
