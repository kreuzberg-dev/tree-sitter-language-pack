         memcpy(&buffer[offset], heredoc->identifier.contents, heredoc->identifier.size);
         offset += heredoc->identifier.size;
+        serialized_heredocs++;
     }
+    buffer[heredoc_count_offset] = (char)serialized_heredocs;
 
